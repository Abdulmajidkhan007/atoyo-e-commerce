# ============ Firebase (Client SDK - public) ============
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============ Firebase Admin SDK (server-only, MAXFIY) ============
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# \n belgilarini saqlab qo'ying (private key ko'p qatorli)
FIREBASE_ADMIN_PRIVATE_KEY=

# ============ Telegram Bot (server-only, MAXFIY) ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ORDERS_ID=1234
TELEGRAM_TOPIC_CONTACT_ID=5678
TELEGRAM_TOPIC_SUBSCRIBERS_ID=9012
# Webhookni tasdiqlash uchun maxfiy token (Telegram secret_token headeri)
TELEGRAM_WEBHOOK_SECRET=

# ============ To'lov tizimlari (ixtiyoriy - kalit kiritilsa faollashadi) ============
# Payme kassa: https://business.payme.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
# Click merchant: https://merchant.click.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ============ Email xabarnoma (ixtiyoriy - SMTP kiritilsa faollashadi) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atoyo Santexnika <no-reply@atoyo-santexnika.uz>"

# ============ Ilova sozlamalari ============
# Server Actions uchun ruxsat etilgan originlar (vergul bilan ajratilgan,
# protokolsiz). Production'da haqiqiy domeningizni qo'shing, masalan:
# ALLOWED_ORIGINS=localhost:3000,atoyo-santexnika.uz
ALLOWED_ORIGINS=localhost:3000
