# ============ Firebase (Client SDK - public) ============
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============ Firebase Admin SDK (server-only, MAXFIY) ============
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# \n belgilarini saqlab qo'ying (private key ko'p qatorli)
FIREBASE_ADMIN_PRIVATE_KEY=

# ============ Telegram Bot (server-only, MAXFIY) ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ORDERS_ID=1234
TELEGRAM_TOPIC_CONTACT_ID=5678
TELEGRAM_TOPIC_SUBSCRIBERS_ID=9012
# "Kirim" topic'i: rasm + izoh tashlansa bot mahsulot yaratadi (0 - o'chirilgan)
TELEGRAM_TOPIC_INTAKE_ID=151
# E'lon kanali: yangi/tahrirlangan mahsulot va blog postlari shu kanalga
# avtomatik chiqadi. @username yoki -100... ko'rinishidagi ID. Bot kanalda
# admin bo'lishi shart. Admin panel > Sozlamalar > Bot sozlamalari dan ham
# kiritish mumkin (u yerdagi qiymat ustunroq).
TELEGRAM_CHANNEL_ID=
# Webhookni tasdiqlash uchun maxfiy token (Telegram secret_token headeri)
# Telegram Login Widget uchun bot useri (@ belgisisiz). Widget ishlashi
# uchun BotFather'da /setdomain bilan sayt domeni botga bog'lanishi shart.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Atoyo_uz_bot
TELEGRAM_WEBHOOK_SECRET=

# ============ To'lov tizimlari (ixtiyoriy - kalit kiritilsa faollashadi) ============
# Payme kassa: https://business.payme.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
# Click merchant: https://merchant.click.uz
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ============ Email xabarnoma (ixtiyoriy - SMTP kiritilsa faollashadi) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MUHIM: Gmail SMTP faqat SMTP_USER manzili nomidan yuboradi. Boshqa
# domen yozilsa xat "Message not delivered / 535 5.7.8" bilan qaytadi.
# Shuning uchun manzil SMTP_USER bilan bir xil bo'lishi kerak.
SMTP_FROM="Atoyo Santexnika <santexnika.atoyo@gmail.com>"

# ============ Ilova sozlamalari ============
# Server Actions uchun ruxsat etilgan originlar (vergul bilan ajratilgan,
# protokolsiz). Production'da haqiqiy domeningizni qo'shing, masalan:
# ALLOWED_ORIGINS=localhost:3000,atoyo-santexnika.uz
ALLOWED_ORIGINS=localhost:3000
