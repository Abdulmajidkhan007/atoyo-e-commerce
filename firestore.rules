rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin yoki owner (loyiha egasi) - ikkalasi ham xodim hisoblanadi.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // Mahsulotlar - hamma o'qiy oladi, faqat admin yoza oladi.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog postlari - hamma o'qiy oladi (public sahifa), faqat admin yoza
    // oladi. Amaliy o'qish/yozishlar server (Admin SDK) orqali bo'ladi.
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Foydalanuvchilar - faqat o'zi yoki admin o'qiy oladi.
    // `role` maydonini faqat admin o'zgartira oladi (foydalanuvchi
    // o'zini o'ziga admin qilib belgilab qo'yishining oldi olinadi).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      // Rol/huquq o'zgartirish FAQAT server (Admin SDK, /api/admin/users)
      // orqali - owner tekshiruvi o'sha yerda. Client faqat o'z profilini
      // (rolini o'zgartirmasdan) tahrirlashi mumkin.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('permissions', {}) == resource.data.get('permissions', {});
    }

    // Buyurtmalar - foydalanuvchi faqat o'z buyurtmasini yaratishi va
    // ko'rishi mumkin; statusni faqat admin/bot (server, Admin SDK orqali,
    // bu qoidalarni chetlab o'tadi) o'zgartira oladi.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Obunachilar - faqat server (Admin SDK) yozadi/o'qiydi.
    match /subscribers/{subscriberId} {
      allow read, write: if false;
    }

    // Kontakt arizalari - faqat server (Admin SDK) yozadi; admin panel
    // ham server orqali o'qiydi.
    match /contactRequests/{requestId} {
      allow read, write: if false;
    }

    // Telegram mijoz-bot sessiyalari (savat, checkout bosqichi) - faqat server.
    match /botSessions/{chatId} {
      allow read, write: if false;
    }

    // Telegram bot orqali ro'yxatdan o'tgan mijozlar (telefon) - faqat server.
    match /botUsers/{userId} {
      allow read, write: if false;
    }

    // Admin interaktiv oqim holati (/yangi, /tahrir bosqichlari) - faqat server.
    match /adminSessions/{userId} {
      allow read, write: if false;
    }

    // Bot sozlamalari (topic thread ID lar) - faqat admin.
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Mahsulot sharhlari - hamma o'qiy oladi; yozish faqat server orqali
    // (/api/products/[id]/reviews) - u yerda "bitta mijoz - bitta sharh"
    // va reyting hisobi tranzaksiyada bajariladi.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Promokodlar - kodni tekshirish ham, tahrirlash ham faqat server
    // orqali (kodlar ro'yxati clientga ochilmasligi kerak).
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // Mahsulot kirimi tarixi - faqat server (Admin SDK) yozadi va o'qiydi.
    match /stockIntakes/{intakeId} {
      allow read, write: if false;
    }

    // Filtr ro'yxatlari (brend/davlat) - hamma o'qiy oladi, server yozadi.
    match /metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Telegram orqali kirish uchun bir martalik kodlar - faqat server.
    match /tgLogins/{code} {
      allow read, write: if false;
    }

    // Rate limit hisoblagichlari - faqat server.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Dashboard tahlillari (umumiy buyurtmalar/tushum) - faqat server
    // (Admin SDK, /api/orders) yozadi; admin panel ham server
    // komponentda Admin SDK orqali o'qiydi, shuning uchun clientga
    // hech qanday to'g'ridan-to'g'ri ruxsat kerak emas.
    match /stats/{statId} {
      allow read, write: if false;
    }
  }
}
