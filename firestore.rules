rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin yoki owner (loyiha egasi) - ikkalasi ham xodim hisoblanadi.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // Mahsulotlar - hamma o'qiy oladi, faqat admin yoza oladi.
    // MAHSULOTLAR - MIJOZ TO'G'RIDAN-TO'G'RI O'QIMAYDI.
    //
    // Hujjat ichida OPTOM narx (`price`), TANNARX (`costPrice`) va
    // yetkazib beruvchi nomi (`supplier`) turadi. Ilgari bu yerda
    // `allow read: if true` edi - ya'ni istalgan odam Firebase SDK
    // bilan raqobatchining optom narxini ham, tannarxini ham o'qib
    // olardi (dona narx faqat EKRANDA hisoblanardi, ma'lumotning
    // o'zi ochiq edi).
    //
    // Endi katalog, qidiruv, sayt, ilova va bot - hammasi server
    // orqali o'qiydi (`/api/products/*`), server esa mahsulotni
    // ko'ruvchining roliga moslab tozalab beradi
    // (`lib/products/viewer.ts`). Admin SDK bu qoidalarga
    // bo'ysunmaydi, shuning uchun server ishlayveradi.
    match /products/{productId} {
      allow read: if false;
      allow write: if false;
    }

    // Blog postlari - hamma o'qiy oladi (public sahifa), faqat admin yoza
    // oladi. Amaliy o'qish/yozishlar server (Admin SDK) orqali bo'ladi.
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Foydalanuvchilar - faqat o'zi yoki admin o'qiy oladi.
    // `role` maydonini faqat admin o'zgartira oladi (foydalanuvchi
    // o'zini o'ziga admin qilib belgilab qo'yishining oldi olinadi).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      // Rol/huquq o'zgartirish FAQAT server (Admin SDK, /api/admin/users)
      // orqali - owner tekshiruvi o'sha yerda. Client faqat o'z profilini
      // (rolini o'zgartirmasdan) tahrirlashi mumkin.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('permissions', {}) == resource.data.get('permissions', {});
    }

    // SAQLANGAN KARTA TOKENLARI - mijozning o'ziga ham ochilmaydi.
    // Token bilan to'lov qilish mumkin, shuning uchun u faqat server
    // (Admin SDK) qo'lida qoladi.
    match /users/{userId}/cards/{cardId} {
      allow read, write: if false;
    }

    // OPTOM MIJOZLAR va ularning kalitlari - faqat server. Kalit
    // ro'yxatda ochiq turadi, shuning uchun clientga umuman berilmaydi.
    // Ijtimoiy tarmoq navbati - faqat server (Admin SDK) ishlatadi.
    match /socialQueue/{jobId} {
      allow read, write: if false;
    }

    match /wholesaleClients/{clientId} {
      allow read, write: if false;
    }

    // Loyiha xarajatlari va to'lovlar tarixi - faqat server (admin panel
    // ham /api/admin/expenses orqali o'qiydi).
    match /expenses/{expenseId} {
      allow read, write: if false;
    }
    match /expensePayments/{paymentId} {
      allow read, write: if false;
    }

    // Ombor harakatlari (kirim/sotuv/chiqim/sanoq) - faqat server.
    match /stockMoves/{moveId} {
      allow read, write: if false;
    }

    // Buyurtmalar - foydalanuvchi faqat o'z buyurtmasini yaratishi va
    // ko'rishi mumkin; statusni faqat admin/bot (server, Admin SDK orqali,
    // bu qoidalarni chetlab o'tadi) o'zgartira oladi.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Obunachilar - faqat server (Admin SDK) yozadi/o'qiydi.
    match /subscribers/{subscriberId} {
      allow read, write: if false;
    }

    // Kontakt arizalari - faqat server (Admin SDK) yozadi; admin panel
    // ham server orqali o'qiydi.
    match /contactRequests/{requestId} {
      allow read, write: if false;
    }

    // Telegram mijoz-bot sessiyalari (savat, checkout bosqichi) - faqat server.
    match /botSessions/{chatId} {
      allow read, write: if false;
    }

    // Telegram bot orqali ro'yxatdan o'tgan mijozlar (telefon) - faqat server.
    match /botUsers/{userId} {
      allow read, write: if false;
    }

    // Admin interaktiv oqim holati (/yangi, /tahrir bosqichlari) - faqat server.
    match /adminSessions/{userId} {
      allow read, write: if false;
    }

    // Bot sozlamalari (topic thread ID lar) - faqat admin.
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Mahsulot sharhlari - hamma o'qiy oladi; yozish faqat server orqali
    // (/api/products/[id]/reviews) - u yerda "bitta mijoz - bitta sharh"
    // va reyting hisobi tranzaksiyada bajariladi.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Promokodlar - kodni tekshirish ham, tahrirlash ham faqat server
    // orqali (kodlar ro'yxati clientga ochilmasligi kerak).
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // Mahsulot kirimi tarixi - faqat server (Admin SDK) yozadi va o'qiydi.
    match /stockIntakes/{intakeId} {
      allow read, write: if false;
    }

    // Telegram "Kirim" topic'idagi albom holati (vaqtinchalik) - faqat server.
    match /intakeAlbums/{mediaGroupId} {
      allow read, write: if false;
    }

    // Sozlamalarni o'zgartirish uchun bir martalik jumboq - faqat server.
    match /adminChallenges/{challengeId} {
      allow read, write: if false;
    }

    // Maxfiy kalitlar (bot tokeni, webhook siri...) - clientga hech qachon
    // ochilmaydi, faqat server (Admin SDK) o'qiydi va yozadi.
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // Filtr ro'yxatlari (brend/davlat) - hamma o'qiy oladi, server yozadi.
    match /metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // OAuth (YouTube/Facebook) uchun bir martalik `state` - faqat server.
    match /oauthStates/{state} {
      allow read, write: if false;
    }

    // Telegram orqali kirish uchun bir martalik kodlar - faqat server.
    match /tgLogins/{code} {
      allow read, write: if false;
    }

    // Rate limit hisoblagichlari - faqat server.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Dashboard tahlillari (umumiy buyurtmalar/tushum) - faqat server
    // (Admin SDK, /api/orders) yozadi; admin panel ham server
    // komponentda Admin SDK orqali o'qiydi, shuning uchun clientga
    // hech qanday to'g'ridan-to'g'ri ruxsat kerak emas.
    match /stats/{statId} {
      allow read, write: if false;
    }
  }
}
