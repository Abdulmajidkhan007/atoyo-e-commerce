rules_version = '2';

// Hamma yozuv Admin SDK orqali ketadi (src/lib/firebase/admin-storage.ts,
// "server-only"), fayllar esa firebaseStorageDownloadTokens bilan ochiq
// URL orqali o'qiladi - client Storage SDK'ga umuman kirmaydi. Papkalar
// (products/<id>, blog, site) va admin ruxsati (src/lib/permissions.ts)
// tekshiruvi shu Admin SDK yo'lida - Storage qoidalari amalda ishlamaydi,
// shuning uchun bu yerda faqat bitta yopiq qoida bor.
service firebase.storage {
  match /{allPaths=**} {
    allow read: if false;
    allow write: if false;
  }
}
