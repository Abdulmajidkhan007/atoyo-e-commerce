<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ da bildirishnoma uchun ruxsat (ilova o'zi so'raydi). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">

      <!-- Push bildirishnomalar uchun standart kanal (server payload'ida
           ham channelId="atoyo"). `tools:replace` SHART: RNFirebase
           kutubxonasi ham shu meta-data ni BO'SH qiymat bilan e'lon
           qiladi va manifestlar birlashtirilganda to'qnashuv chiqadi. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="atoyo"
        tools:replace="android:value" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Bosh ekran widgetlari shu sxema bilan ochadi (masalan
             atoyo://buyurtmalar) - React Navigation `linking` ni
             `App.tsx` da qabul qiladi. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="atoyo" />
        </intent-filter>
      </activity>

      <!-- BOSH EKRAN WIDGETLARI (androidx.glance). Ma'lumot RN tomonidan
           SharedPreferences'ga yoziladi (`AtoyoWidgetsModule.kt`); widget
           tarmoqqa o'zi chiqmaydi, faqat o'sha yozuvni o'qiydi. -->
      <receiver
        android:name=".widget.OrderWidgetReceiver"
        android:exported="true"
        android:label="@string/widget_order_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/order_widget_info" />
      </receiver>

      <receiver
        android:name=".widget.CartWidgetReceiver"
        android:exported="true"
        android:label="@string/widget_cart_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/cart_widget_info" />
      </receiver>

      <receiver
        android:name=".widget.StaffWidgetReceiver"
        android:exported="true"
        android:label="@string/widget_staff_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/staff_widget_info" />
      </receiver>
    </application>
</manifest>
